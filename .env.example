# Supabase: Dashboard > Project Settings > API Keys (e Data API para a URL)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Chave pública (anon / publishable). Segura no navegador; o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role / secret). Só no servidor; ignora o RLS. Nunca use prefixo NEXT_PUBLIC_.
# Obrigatória para o pré-cadastro (/sou-veterinario), que grava só pelo servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Ref do projeto (o trecho <project-ref> da URL do dashboard). Usado por npm run db:types.
SUPABASE_PROJECT_REF=

# Connection string do Postgres: Dashboard > botão "Connect" > Session pooler.
# Usado por npm run db:seed e npm run db:remove-demo.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# URL pública do site (metadados, sitemap, compartilhamento). Na Vercel, sem ela,
# usa o domínio de produção do projeto automaticamente.
NEXT_PUBLIC_SITE_URL=

# E-mails que podem pedir link de acesso ao /admin, separados por vírgula.
# O banco confere de novo pela tabela public.admins.
ADMIN_EMAILS=
